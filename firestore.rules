rules_version = '2';

// =============================================================
//  REGLAS DE SEGURIDAD — Los Juegos de Omega
//
//  Pegar en: consola de Firebase -> Firestore Database -> Reglas
//  Proyecto: los-juegos-de-omega
//
//  QUÉ CAMBIA
//  Hoy la base de datos está abierta: cualquiera con el enlace de una de las
//  apps puede leerla entera y escribir en ella. Con estas reglas hay que haber
//  entrado con usuario y contraseña, y además hay TRES niveles de permiso.
//
//  LOS TRES USUARIOS
//  - staff@juegos.com  -> los 15 del staff, en sus propios móviles.
//    Solo puede hacer lo que necesita la app de staff: ver los dorsales,
//    montar equipos, proponer eliminaciones y pedir ayuda.
//    NO puede ver las entradas vendidas (nombres y edades), ni eliminar a
//    nadie de verdad, ni tocar la pantalla LED, ni borrar copias de seguridad.
//    Su contraseña puede circular por el grupo del staff sin riesgo.
//
//  - puerta@juegos.com -> los cuatro puestos de acreditación y el panel de
//    la mesa de la puerta. Puede ver las entradas vendidas y acreditar:
//    entregar un dorsal, marcar entradas y salidas, corregir un dorsal mal
//    dado. NADA MÁS. No elimina a nadie, no toca la pantalla LED, no gira
//    bingos, no ve ni borra copias de seguridad.
//    Hace falta porque las entradas llevan nombres y edades y la cuenta del
//    staff no puede verlas; y porque dar una cuenta de mando a cuatro
//    voluntarios de la puerta es darles el evento entero.
//
//  - Cualquier otro usuario (infomegawg@gmail.com, omega@juegos.com...) -> tú y
//    quien lleve el Panel Central, la pantalla LED y las pantallas de los
//    capitanes. Permiso completo. Esas contraseñas NO se dan al staff ni a la
//    puerta.
//
//  Cualquier usuario que no sea staff@juegos.com ni puerta@juegos.com se
//  considera "mando".
//  Por eso los usuarios del panel hay que crearlos tú en la consola: no se
//  puede dar de alta nadie desde las apps.
//
//  IMPORTANTE — ORDEN DE LOS PASOS
//  1) Crear los usuarios en Authentication -> Users.
//  2) Pegar estas reglas y publicar.
//  3) Probar UNA vez con un dispositivo de cada tipo: panel, LED, un móvil
//     del staff, un móvil de la puerta y un PC de capitán.
//  Desde el momento en que se publican, cualquier dispositivo que no haya
//  iniciado sesión deja de funcionar hasta que lo haga.
// =============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Quién es quién ----
    function identificado() {
      return request.auth != null;
    }

    // El móvil de un miembro del staff.
    function esStaff() {
      return identificado() && request.auth.token.email == 'staff@juegos.com';
    }

    // Los puestos de acreditación y el panel de la mesa de la puerta.
    function esPuerta() {
      return identificado() && request.auth.token.email == 'puerta@juegos.com';
    }

    // Quien puede acreditar en la puerta. El staff entra aquí a propósito:
    // así se puede mover a cualquiera de la puerta al campo y al revés sin
    // cerrar sesiones. A cambio, los móviles del staff pueden leer la lista
    // de entradas, con los nombres y las edades.
    function acredita() {
      return esPuerta() || esStaff();
    }

    // Panel Central, pantalla LED y capitanes: cualquier usuario identificado
    // que no sea el del staff ni el de la puerta.
    function esMando() {
      return identificado() && !esStaff() && !esPuerta();
    }

    // ---- Jugadores y resultados ----
    // El staff los ve en su app para poder marcar, pero no elimina ni salva:
    // eso lo ejecuta el Panel Central al aprobar la propuesta.
    // Quien acredita (la puerta o el staff) solo ACTUALIZA: le pone su entrada, su
    // nombre y lo devuelve al juego. Ni crea dorsales ni los borra: los
    // dorsales se crean desde el Panel Central.
    match /participantes/{dorsal}      { allow read: if identificado(); allow write: if esMando(); allow update: if acredita(); }
    match /eliminaciones/{dorsal}      { allow read: if identificado(); allow write: if esMando(); }
    match /eliminaciones_multiples/{d} { allow read: if identificado(); allow write: if esMando(); }
    match /salvaciones/{id}            { allow read: if identificado(); allow write: if esMando(); }

    // ---- Estado del evento y pantallas ----
    // La prueba en curso, el modo de la pantalla LED, los anuncios por
    // megafonía, las ruletas de los bingos y la Batalla Naval. Solo el mando:
    // un móvil del staff no debe poder girar una ruleta ni cambiar el LED.
    match /sesion/{id}             { allow read: if identificado(); allow write: if esMando(); }
    match /llamadas/{id}           { allow read: if identificado(); allow write: if esMando(); }
    match /bingo_comandos/{id}     { allow read: if identificado(); allow write: if esMando(); }
    match /salvacion_comandos/{id} { allow read: if identificado(); allow write: if esMando(); }
    match /batalla_naval/{id}      { allow read: if identificado(); allow write: if esMando(); }
    match /presencia/{id}          { allow read: if identificado(); allow write: if esMando(); }

    // ---- Equipos ----
    // El staff los monta desde su móvil. Dentro de la app, un equipo solo lo
    // puede retirar quien lo creó; el panel puede editar o disolver cualquiera.
    match /equipos/{id} { allow read, create, update: if identificado(); allow delete: if esMando(); }

    // ---- Parejas ----
    // Mismo trato que los equipos: el staff marca las que forman los propios
    // jugadores y el panel sortea las que forma la organización. Cerrar una
    // pareja (marcarla como jugada) lo hace el panel al eliminar a uno de los
    // dos; el staff solo puede deshacer una suya que aún no haya jugado.
    match /parejas/{id} { allow read, create, update: if identificado(); allow delete: if esMando(); }

    // ---- Actas de prueba ----
    // El recorrido de cada prueba: quien entro, quien jugo, quien cayo y quien
    // clasifico. Las escribe el Panel Central al cambiar de prueba. El staff
    // las puede leer, pero no tocarlas, y NADIE las borra desde las apps: un
    // acta es la prueba documental si alguien reclama al dia siguiente.
    match /actas/{id} {
      allow read: if identificado();
      allow create, update: if esMando();
      allow delete: if false;
    }

    // ---- Lo que el staff manda al Panel Central ----
    // Puede crear propuestas y avisos de ayuda, y ver los suyos. Aprobarlas,
    // descartarlas o marcar una ayuda como atendida es cosa del mando: así una
    // eliminación nunca llega a ejecutarse sin pasar por el panel.
    match /staff_propuestas/{id} { allow read, create: if identificado(); allow update, delete: if esMando(); }
    match /staff_ayuda/{id}      { allow read, create: if identificado(); allow update, delete: if esMando(); }
    match /staff_presencia/{id}  { allow read, write: if identificado(); }

    // ---- Copias de seguridad ----
    // Solo el mando. Se pueden crear y leer, pero no borrar: que un fallo o un
    // clic de más no deje al evento sin ningún respaldo.
    match /backups/{id}            { allow read, create, update: if esMando(); allow delete: if false; }
    match /backups_auto/{id}       { allow read, create, update: if esMando(); allow delete: if esMando(); }
    match /backups_historicos/{id} { allow read, create, update: if esMando(); allow delete: if false; }

    // ---- Entradas vendidas ----
    // Datos personales: nombre, edad y si es menor. Solo el mando, nunca el
    // staff, aunque su contraseña ande por el grupo de WhatsApp.
    // El DNI, el correo, el teléfono y la fecha de nacimiento no se suben
    // nunca: se quedan en el Excel de Enterticket.
    // No se borran desde las apps: una entrada que ya no vale se marca como
    // anulada, no se elimina.
    // Quien acredita lee y actualiza: acreditar, marcar dentro y fuera, corregir un
    // dorsal mal dado. No crea entradas: esas entran con el XLSX de
    // Enterticket desde el Panel Central.
    match /entradas/{codigo} {
      allow read, create, update: if esMando();
      allow read, update: if acredita();
      allow delete: if false;
    }

    // ---- Todo lo demás, cerrado ----
    match /{documento=**} {
      allow read, write: if false;
    }
  }
}
